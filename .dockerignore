# Knowledge graph (dev artifact; the public Pages graph is rebuilt in CI)
graphify-out/

# Logs
*.log
logs/

# Node / frontend tooling (vendored assets live in static/vendor/ and are
# already committed; node_modules is only needed to regenerate them).
node_modules/
package*.json
playwright.config.js
eslint.config.js

# Repository-only build, test, and release inputs. requirements.txt remains
# available because it is the reviewed runtime lock installed by Dockerfile.
requirements.in
requirements-test.*
requirements-graph.*
scripts/
.trivyignore.yaml
.env.example
docker-compose*.yml

# Distribution / packaging
build/
dist/
*.egg-info/

# Documentation (not needed in container)
README.md
docs/

# Test files
tests/
test_*.py
*_test.py

# Backup files
*.bak
*.backup
*.orig
